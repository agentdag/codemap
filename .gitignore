# Added by Cargo - contains compiled binaries, artifacts, and dependencies
/target/

# Backup files generated by rustfmt when formatting code
**/*.rs.bk

# MSVC Windows builds of rustc generate these to store debugging information
*.pdb

# Generated by cargo mutants (mutation testing tool)
**/mutants.out*/

# Compiled stack traces dumped by rustc during an internal compiler error
rustc-ice-*.txt

node_modules